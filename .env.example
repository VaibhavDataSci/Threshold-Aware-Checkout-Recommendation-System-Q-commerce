# ==============================================================================
# Threshold-Aware Checkout Recommendation System - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the root directory: `cp .env.example .env`
# 2. Update the variable values as appropriate for your local or deployment environment.
# 3. DO NOT commit the actual '.env' file containing real secrets or environment configs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
# Running environment: 'development', 'testing', or 'production'
APP_ENV=development

# Port for the Streamlit UI application
STREAMLIT_SERVER_PORT=8501

# Logging verbosity level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Business & Threshold Rules
# ------------------------------------------------------------------------------
# Fixed free-delivery threshold amount in INR (default: 150)
FREE_DELIVERY_THRESHOLD=150

# Lower cart threshold for add-on suggestions (INR)
CART_ADDON_SUGGESTION_THRESHOLD=1000

# Upper cart threshold for premium discount application (INR)
CART_PREMIUM_DISCOUNT_THRESHOLD=3000

# ------------------------------------------------------------------------------
# 3. Recommendation Engine Settings
# ------------------------------------------------------------------------------
# Maximum number of product recommendations to display (Max allowed: 6 items)
MAX_RECOMMENDATIONS=6

# Weight for deep learning neural model score in final ranking (0.0 to 1.0)
MODEL_RELEVANCE_WEIGHT=0.7

# Weight for threshold gap usefulness score in final ranking (0.0 to 1.0)
THRESHOLD_RELEVANCE_WEIGHT=0.3

# ------------------------------------------------------------------------------
# 4. Input Validation & Security Rules
# ------------------------------------------------------------------------------
# Minimum character length for user search/filter queries (IF query length < 2 -> reject)
MIN_QUERY_LENGTH=2

# Maximum allowable API/UI request rate per minute before temporary rate-limiting block
REQUEST_RATE_LIMIT=60

# Secret key for session security / CSRF protection (keep private in real .env)
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# ------------------------------------------------------------------------------
# 5. User Behavior & Session Rules
# ------------------------------------------------------------------------------
# Inactivity time threshold in seconds before triggering a discount/promo popup (default: 10s)
INACTIVITY_TIMEOUT_SECONDS=10

# Prioritize personalized recommendations for returning users (true / false)
PRIORITIZE_RETURNING_USERS=true

# ------------------------------------------------------------------------------
# 6. Performance & Caching Rules
# ------------------------------------------------------------------------------
# Time-To-Live (TTL) in seconds for caching repeated recommendation query results
CACHE_EXPIRY_SECONDS=300

# Enable response caching for repeated queries (true / false)
ENABLE_QUERY_CACHE=true

# ------------------------------------------------------------------------------
# 7. Data & Model File Paths
# ------------------------------------------------------------------------------
# Path to products dataset CSV file
PRODUCTS_DATA_PATH=data/products.csv

# Path to user interactions dataset CSV file
INTERACTIONS_DATA_PATH=data/interactions.csv

# Path to saved trained neural recommendation model artifact
MODEL_PATH=model/saved_model.pt

# ------------------------------------------------------------------------------
# 8. MLOps & Experiment Tracking (Optional / Future Integration)
# ------------------------------------------------------------------------------
# MLflow server tracking URI
MLFLOW_TRACKING_URI=http://localhost:5000

# MLflow experiment name for model logging and reproducibility
MLFLOW_EXPERIMENT_NAME=threshold_checkout_recommendation_system
